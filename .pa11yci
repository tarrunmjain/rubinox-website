{
    "defaults":  {
                     "timeout":  30000,
                     "standard":  "WCAG2AA",
                     "chromeLaunchConfig":  {
                                                "args":  [
                                                             "--headless=new",
                                                             "--no-sandbox",
                                                             "--disable-gpu",
                                                             "--disable-dev-shm-usage"
                                                         ]
                                            },
                     "reporters":  [
                                       "cli",
                                       [
                                           "json",
                                           {
                                               "fileName":  "./reports/pa11y-ci.json"
                                           }
                                       ]
                                   ],
                     "threshold":  7
                 },
